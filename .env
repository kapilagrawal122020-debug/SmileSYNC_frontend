# true  = demo mode: runs entirely in the browser with sample data (no backend needed)
# false = talk to the hosted API (https://kapilagrawal.pythonanywhere.com).
# You can also flip this on the login screen.
VITE_USE_MOCK=false

# Leave empty in dev: the Vite proxy (vite.config.js) forwards /api to the hosted API.
# A production build uses the URL in .env.production.
VITE_API_URL=
